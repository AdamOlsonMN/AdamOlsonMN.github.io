---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import PageNav from '../../components/PageNav.astro';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({ ...post.data, href: `/blog/${post.id}/` }));
---

<Base
	title="Blog"
	description="Writing on data, R, SQL, and whatever else seems worth a post."
>
	<h1>Blog</h1>
	<PageNav />
	<p>
		Mostly data and analysis write-ups. Older political-science and academic-life posts live in
		the <a href="/archive">archive</a> instead.
	</p>
	<Card posts={posts} />
</Base>
