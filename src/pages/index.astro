---
import Card from '../components/Card.astro';
import PageNav from '../components/PageNav.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({ ...post.data, href: `/blog/${post.id}/` }));
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<h1>Adam Olson</h1>
		<PageNav />
		<p class="subhead">
			Data scientist. Political scientist in a previous life.
		</p>
		<p class="lede">I live in Minnesota and like folk music.</p>
	</section>

	{posts.length > 0 && (
		<section>
			<h2 class="eyebrow">Writing</h2>
			<Card posts={posts} />
			<p class="more"><a href="/blog">See all posts &rarr;</a></p>
		</section>
	)}

	<section>
		<h2 class="eyebrow">Older writing</h2>
		<p>
			I blogged about Congress and politics from 2014 to 2017. Those posts are in the
			<a href="/archive">archive</a>.
		</p>
	</section>

	<section>
		<h2 class="eyebrow">Elsewhere</h2>
		<div class="elsewhere">
			<a href="mailto:adam@adamolson.org">Email</a>
			<a href="https://github.com/AdamOlsonMN">GitHub</a>
			<a href="https://www.linkedin.com/in/adamolsonmn">LinkedIn</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		margin-bottom: 2.6em;
	}

	.hero h1 {
		margin-bottom: 0.5em;
	}

	.subhead {
		font-size: 1.15rem;
		font-weight: 600;
		max-width: 42ch;
		margin: 0 0 0.7em;
	}

	.lede {
		margin: 0;
		max-width: 56ch;
		color: var(--color-ink-soft);
	}

	section {
		margin-bottom: 2.4em;
	}

	.eyebrow {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
		border-top: var(--border-width) solid var(--color-border);
		padding-top: 0.9em;
		margin: 0 0 0.9em;
	}

	.more {
		margin: 0.9em 0 0;
		font-size: 0.9rem;
	}

	.elsewhere {
		display: flex;
		gap: 1.4em;
		flex-wrap: wrap;
	}

	.elsewhere a {
		font-family: var(--font-mono, monospace);
		font-size: 0.85rem;
	}
</style>
