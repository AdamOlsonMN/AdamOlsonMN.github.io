---
import Card from '../components/Card.astro';
import PageNav from '../components/PageNav.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({ ...post.data, href: `/blog/${post.id}/` }));
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<h1>Adam Olson</h1>
		<PageNav />
		<p class="subhead">
			Data scientist by day, recovering political scientist by training, Midwesterner the rest
			of the time.
		</p>
		<p class="lede">
			<!-- TODO(Adam): one or two sentences on what that work looks like -->
			I spent my twenties studying how Congress makes — or fails to make — laws, and now I spend
			my days doing data science at Essentia Health. I still think like an academic — a
			well-specified question, a clean plot, a citation when one's warranted — I just apply it to
			different problems these days. When I'm not doing that: midwestern sports teams, state
			parks, and a healthy amount of PBS. Read more on the <a href="/about">about page</a>.
		</p>
	</section>

	{posts.length > 0 && (
		<section>
			<h2 class="eyebrow">Writing</h2>
			<Card posts={posts} />
			<p class="more"><a href="/blog">See all posts &rarr;</a></p>
		</section>
	)}

	<section>
		<h2 class="eyebrow">Older writing</h2>
		<p>
			Between 2014 and 2019 I wrote a lot about Congress, politics, and academic life. Some of it
			holds up better than others. It's all still here in the <a href="/archive">archive</a>.
		</p>
	</section>

	<section>
		<h2 class="eyebrow">Elsewhere</h2>
		<div class="elsewhere">
			<a href="mailto:adam@adamolson.org">Email</a>
			<a href="https://github.com/AdamOlsonMN">GitHub</a>
			<a href="https://www.linkedin.com/in/adamolsonmn">LinkedIn</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		margin-bottom: 2.6em;
	}

	.hero h1 {
		margin-bottom: 0.5em;
	}

	.subhead {
		font-size: 1.15rem;
		font-weight: 600;
		max-width: 42ch;
		margin: 0 0 0.7em;
	}

	.lede {
		margin: 0;
		max-width: 56ch;
		color: var(--color-ink-soft);
	}

	section {
		margin-bottom: 2.4em;
	}

	.eyebrow {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
		border-top: var(--border-width) solid var(--color-border);
		padding-top: 0.9em;
		margin: 0 0 0.9em;
	}

	.more {
		margin: 0.9em 0 0;
		font-size: 0.9rem;
	}

	.elsewhere {
		display: flex;
		gap: 1.4em;
		flex-wrap: wrap;
	}

	.elsewhere a {
		font-family: var(--font-mono, monospace);
		font-size: 0.85rem;
	}
</style>
