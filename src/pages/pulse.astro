---
import Base from '../layouts/Base.astro';
---

<Base
	title="World Pulse (sketch)"
	description="A living dashboard sketch: global news-coverage volume by topic, fetched live from the GDELT Project."
>
	<h1>World Pulse</h1>
	<p class="lede">
		A sketch, not a finished feature — reachable at <code>/pulse</code> but not linked from
		navigation yet. Every load fetches fresh data client-side from the
		<a href="https://www.gdeltproject.org/">GDELT Project</a>'s public DOC 2.0 API: no backend,
		no build-time snapshot, no API key. It shows daily global news-coverage volume (what share of
		everything GDELT monitors that day mentioned the topic) for three example topics over the
		trailing 30 days. See <code>docs/pulse-concept.md</code> in this repo for the fuller writeup —
		what this could grow into, and why a "living" dashboard is even possible on a static site.
	</p>

	<div class="viz-root" id="pulse-root" data-palette="#2a78d6,#eb6834,#1baf7a">
		<div class="legend" id="pulse-legend" aria-hidden="true"></div>
		<div class="chart-wrap">
			<svg id="pulse-chart" viewBox="0 0 800 340" role="img" aria-labelledby="pulse-chart-title">
				<title id="pulse-chart-title">Daily share of global news coverage by topic, trailing 30 days</title>
			</svg>
			<div id="pulse-tooltip" class="tooltip" hidden></div>
		</div>
		<p id="pulse-status" class="status" role="status">Loading topic 1 of 3…</p>
		<button id="pulse-table-toggle" type="button" class="table-toggle" hidden>View as table</button>
		<div id="pulse-table-wrap" class="table-wrap" hidden></div>
	</div>

	<p class="note">
		GDELT rate-limits this endpoint to one request every 5 seconds, so the three topics load
		one at a time rather than all at once — that's why the chart fills in gradually instead of
		appearing all at once.
	</p>
</Base>

<style>
	.lede {
		max-width: 65ch;
	}
	.note {
		max-width: 65ch;
		font-size: 0.9rem;
		opacity: 0.75;
	}

	.viz-root {
		color-scheme: light;
		--surface-1: #fcfcfb;
		--text-primary: #0b0b0b;
		--text-secondary: #52514e;
		--text-muted: #898781;
		--gridline: #e1e0d9;
		--baseline: #c3c2b7;
		--series-1: #2a78d6;
		--series-2: #eb6834;
		--series-3: #1baf7a;
		margin: 1.5rem 0;
		padding: 1.25rem;
		border: 1px solid var(--baseline);
		border-radius: 8px;
		background: var(--surface-1);
		color: var(--text-primary);
	}
	@media (prefers-color-scheme: dark) {
		:root:where(:not([data-theme='light'])) .viz-root {
			color-scheme: dark;
			--surface-1: #1a1a19;
			--text-primary: #ffffff;
			--text-secondary: #c3c2b7;
			--text-muted: #898781;
			--gridline: #2c2c2a;
			--baseline: #383835;
			--series-1: #3987e5;
			--series-2: #d95926;
			--series-3: #199e70;
		}
	}
	:root[data-theme='dark'] .viz-root {
		color-scheme: dark;
		--surface-1: #1a1a19;
		--text-primary: #ffffff;
		--text-secondary: #c3c2b7;
		--text-muted: #898781;
		--gridline: #2c2c2a;
		--baseline: #383835;
		--series-1: #3987e5;
		--series-2: #d95926;
		--series-3: #199e70;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 0.75rem;
		font-size: 0.85rem;
	}
	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-secondary);
	}
	.legend-swatch {
		width: 12px;
		height: 12px;
		border-radius: 2px;
		flex: none;
	}

	.chart-wrap {
		position: relative;
	}
	#pulse-chart {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.grid-line {
		stroke: var(--gridline);
		stroke-width: 1;
	}
	.axis-label {
		fill: var(--text-muted);
		font-size: 10px;
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
	}
	.series-line {
		fill: none;
		stroke-width: 2;
	}
	.crosshair {
		stroke: var(--baseline);
		stroke-width: 1;
		display: none;
	}
	.hover-dot {
		r: 3.5;
		display: none;
	}

	.tooltip {
		position: absolute;
		pointer-events: none;
		background: var(--surface-1);
		border: 1px solid var(--baseline);
		border-radius: 4px;
		padding: 0.4rem 0.6rem;
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--text-primary);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		white-space: nowrap;
	}

	.status {
		font-size: 0.85rem;
		color: var(--text-secondary);
		margin: 0.75rem 0 0;
	}

	.table-toggle {
		margin-top: 0.75rem;
		font: inherit;
		font-size: 0.8rem;
		background: transparent;
		border: 1px solid var(--baseline);
		border-radius: 4px;
		padding: 0.3rem 0.7rem;
		cursor: pointer;
		color: var(--text-primary);
	}
	.table-wrap {
		margin-top: 0.75rem;
		max-height: 260px;
		overflow: auto;
	}
	.table-wrap table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.8rem;
	}
	.table-wrap th,
	.table-wrap td {
		text-align: right;
		padding: 0.25rem 0.6rem;
		border-bottom: 1px solid var(--gridline);
	}
	.table-wrap th:first-child,
	.table-wrap td:first-child {
		text-align: left;
	}
</style>

<script>
	// Editable: three example topics. Each becomes one line in the chart.
	// Swap these for whatever's interesting — this is a sketch, not a fixed config.
	const TOPICS = ['inflation', 'artificial intelligence', 'immigration'];
	const SERIES_COLORS = ['var(--series-1)', 'var(--series-2)', 'var(--series-3)'];

	type TimelinePoint = { date: string; value: number };

	// GDELT rate-limits to ~1 request/5s. Fetching topics in parallel gets throttled/blocked,
	// so this fetches sequentially with a delay between requests instead.
	const REQUEST_DELAY_MS = 5500;

	function parseGdeltDate(raw: string): Date {
		// Format: "20260807T000000Z"
		const y = Number(raw.slice(0, 4));
		const m = Number(raw.slice(4, 6)) - 1;
		const d = Number(raw.slice(6, 8));
		return new Date(Date.UTC(y, m, d));
	}

	async function fetchTimeline(topic: string): Promise<TimelinePoint[]> {
		const url = `https://api.gdeltproject.org/api/v2/doc/doc?query=${encodeURIComponent(
			topic
		)}&mode=timelinevol&format=json&timespan=30days`;
		const res = await fetch(url);
		if (!res.ok) {
			throw new Error(`GDELT request failed for "${topic}": ${res.status}`);
		}
		const data = await res.json();
		const series = data?.timeline?.[0]?.data;
		if (!Array.isArray(series)) {
			throw new Error(`Unexpected GDELT response shape for "${topic}"`);
		}
		return series.map((point: { date: string; value: number }) => ({
			date: point.date,
			value: point.value,
		}));
	}

	function sleep(ms: number): Promise<void> {
		return new Promise((resolve) => setTimeout(resolve, ms));
	}

	function renderLegend() {
		const legend = document.getElementById('pulse-legend')!;
		legend.innerHTML = TOPICS.map(
			(topic, i) => `
			<span class="legend-item">
				<span class="legend-swatch" style="background:${SERIES_COLORS[i]}"></span>
				${topic}
			</span>
		`
		).join('');
		legend.removeAttribute('aria-hidden');
	}

	function renderChart(seriesByTopic: (TimelinePoint[] | null)[]) {
		const svg = document.getElementById('pulse-chart')!;
		const width = 800;
		const height = 340;
		const margin = { top: 16, right: 16, bottom: 28, left: 40 };
		const plotW = width - margin.left - margin.right;
		const plotH = height - margin.top - margin.bottom;

		const allPoints = seriesByTopic.filter((s): s is TimelinePoint[] => s !== null).flat();
		if (allPoints.length === 0) {
			svg.innerHTML = '';
			return;
		}

		const dates = allPoints.map((p) => parseGdeltDate(p.date).getTime());
		const minX = Math.min(...dates);
		const maxX = Math.max(...dates);
		const maxY = Math.max(...allPoints.map((p) => p.value), 0.1);

		const x = (t: number) => margin.left + ((t - minX) / Math.max(maxX - minX, 1)) * plotW;
		const y = (v: number) => margin.top + plotH - (v / maxY) * plotH;

		let svgContent = '';

		// gridlines (4 horizontal bands)
		for (let i = 0; i <= 4; i++) {
			const gy = margin.top + (plotH / 4) * i;
			const value = (maxY * (4 - i)) / 4;
			svgContent += `<line class="grid-line" x1="${margin.left}" y1="${gy}" x2="${
				width - margin.right
			}" y2="${gy}" />`;
			svgContent += `<text class="axis-label" x="${margin.left - 6}" y="${gy + 3}" text-anchor="end">${value.toFixed(
				1
			)}%</text>`;
		}

		// x-axis date labels (start, middle, end)
		const labelTimes = [minX, (minX + maxX) / 2, maxX];
		for (const t of labelTimes) {
			const d = new Date(t);
			const label = `${d.getUTCMonth() + 1}/${d.getUTCDate()}`;
			svgContent += `<text class="axis-label" x="${x(t)}" y="${height - margin.bottom + 16}" text-anchor="middle">${label}</text>`;
		}

		// series lines
		seriesByTopic.forEach((series, i) => {
			if (!series || series.length === 0) return;
			const points = series
				.map((p) => `${x(parseGdeltDate(p.date).getTime())},${y(p.value)}`)
				.join(' ');
			svgContent += `<polyline class="series-line" points="${points}" stroke="${SERIES_COLORS[i]}" />`;
		});

		svgContent += `<line class="crosshair" id="pulse-crosshair" x1="0" y1="${margin.top}" x2="0" y2="${
			margin.top + plotH
		}" />`;
		seriesByTopic.forEach((_, i) => {
			svgContent += `<circle class="hover-dot" id="pulse-dot-${i}" fill="${SERIES_COLORS[i]}" />`;
		});
		svgContent += `<rect x="${margin.left}" y="${margin.top}" width="${plotW}" height="${plotH}" fill="transparent" id="pulse-hover-target" />`;

		svg.innerHTML = svgContent;

		attachHover(seriesByTopic, x, y, minX, maxX, margin, plotW);
	}

	function attachHover(
		seriesByTopic: (TimelinePoint[] | null)[],
		x: (t: number) => number,
		_y: (v: number) => number,
		minX: number,
		maxX: number,
		margin: { top: number; left: number },
		plotW: number
	) {
		const target = document.getElementById('pulse-hover-target');
		const crosshair = document.getElementById('pulse-crosshair');
		const tooltip = document.getElementById('pulse-tooltip')!;
		const svg = document.getElementById('pulse-chart')! as unknown as SVGSVGElement;
		if (!target || !crosshair) return;

		target.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const scaleX = 800 / rect.width;
			const svgX = (e.clientX - rect.left) * scaleX;
			const frac = Math.min(Math.max((svgX - margin.left) / plotW, 0), 1);
			const t = minX + frac * (maxX - minX);

			crosshair.style.display = 'block';
			crosshair.setAttribute('x1', String(x(t)));
			crosshair.setAttribute('x2', String(x(t)));

			const lines: string[] = [];
			const nearestDate = new Date(t);
			lines.push(`${nearestDate.getUTCMonth() + 1}/${nearestDate.getUTCDate()}`);

			seriesByTopic.forEach((series, i) => {
				const dot = document.getElementById(`pulse-dot-${i}`);
				if (!series || series.length === 0 || !dot) return;
				let nearest = series[0];
				let nearestDiff = Infinity;
				for (const p of series) {
					const diff = Math.abs(parseGdeltDate(p.date).getTime() - t);
					if (diff < nearestDiff) {
						nearestDiff = diff;
						nearest = p;
					}
				}
				dot.style.display = 'block';
				dot.setAttribute('cx', String(x(parseGdeltDate(nearest.date).getTime())));
				dot.setAttribute('cy', String(_y(nearest.value)));
				lines.push(`${TOPICS[i]}: ${nearest.value.toFixed(2)}%`);
			});

			tooltip.hidden = false;
			tooltip.innerHTML = lines.join('<br>');
			tooltip.style.left = `${e.clientX - rect.left + 12}px`;
			tooltip.style.top = `${e.clientY - rect.top + 12}px`;
		});

		target.addEventListener('mouseleave', () => {
			crosshair.style.display = 'none';
			tooltip.hidden = true;
			seriesByTopic.forEach((_, i) => {
				const dot = document.getElementById(`pulse-dot-${i}`);
				if (dot) dot.style.display = 'none';
			});
		});
	}

	function renderTable(seriesByTopic: (TimelinePoint[] | null)[]) {
		const wrap = document.getElementById('pulse-table-wrap')!;
		const allDates = new Set<string>();
		seriesByTopic.forEach((s) => s?.forEach((p) => allDates.add(p.date)));
		const sortedDates = Array.from(allDates).sort();

		const rows = sortedDates
			.map((date) => {
				const cells = seriesByTopic
					.map((series) => {
						const point = series?.find((p) => p.date === date);
						return `<td>${point ? point.value.toFixed(2) + '%' : '—'}</td>`;
					})
					.join('');
				const d = parseGdeltDate(date);
				return `<tr><td>${d.getUTCMonth() + 1}/${d.getUTCDate()}</td>${cells}</tr>`;
			})
			.join('');

		wrap.innerHTML = `
			<table>
				<thead><tr><th>Date</th>${TOPICS.map((t) => `<th>${t}</th>`).join('')}</tr></thead>
				<tbody>${rows}</tbody>
			</table>
		`;
	}

	async function main() {
		renderLegend();
		const status = document.getElementById('pulse-status')!;
		const seriesByTopic: (TimelinePoint[] | null)[] = TOPICS.map(() => null);

		for (let i = 0; i < TOPICS.length; i++) {
			status.textContent = `Loading topic ${i + 1} of ${TOPICS.length} (${TOPICS[i]})…`;
			try {
				seriesByTopic[i] = await fetchTimeline(TOPICS[i]);
			} catch (err) {
				console.error(err);
				status.textContent = `Couldn't load "${TOPICS[i]}" from GDELT — see console for details.`;
			}
			renderChart(seriesByTopic);
			if (i < TOPICS.length - 1) {
				await sleep(REQUEST_DELAY_MS);
			}
		}

		status.textContent = `Loaded ${TOPICS.length} topics, trailing 30 days, from GDELT.`;
		renderTable(seriesByTopic);

		const toggle = document.getElementById('pulse-table-toggle')!;
		const tableWrap = document.getElementById('pulse-table-wrap')!;
		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			const isHidden = tableWrap.hidden;
			tableWrap.hidden = !isHidden;
			toggle.textContent = isHidden ? 'Hide table' : 'View as table';
		});
	}

	main();
</script>
