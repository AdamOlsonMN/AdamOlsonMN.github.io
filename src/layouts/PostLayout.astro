---
import ArchiveBanner from '../components/ArchiveBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageNav from '../components/PageNav.astro';
import VintageNote from '../components/VintageNote.astro';
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	variant: 'blog' | 'archive';
	category?: 'commentary' | 'academic';
	context?: string;
}

const { title, description, pubDate, updatedDate, tags, variant, category, context } =
	Astro.props;
---

<Base title={title} description={description} article={{ published: pubDate, modified: updatedDate }}>
	<article>
		{variant === 'archive' && category && (
			<ArchiveBanner pubDate={pubDate} category={category} context={context} />
		)}
		<header class="post-header">
			<h1>{title}</h1>
			<PageNav />
			<p class="meta">
				<FormattedDate date={pubDate} />
				{tags && tags.length > 0 && (
					<span class="tags">
						{tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</span>
				)}
			</p>
		</header>
		{variant === 'blog' && <VintageNote pubDate={pubDate} />}
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<script>
	// Wraps each code block so a copy button can sit outside its scroll area.
	for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.replaceWith(wrapper);
		wrapper.append(pre);

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-code';
		button.textContent = 'Copy';
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Copy failed';
			}
			setTimeout(() => (button.textContent = 'Copy'), 2000);
		});
		wrapper.append(button);
	}
</script>

<style>
	.post-header {
		margin-bottom: 1.5em;
	}

	.meta {
		color: var(--color-ink-soft);
		font-size: 0.85rem;
		font-family: var(--font-mono, monospace);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6em;
		margin-top: 0.3em;
	}

	.tags {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
	}

	.tag {
		color: var(--color-accent);
	}

	.tag::before {
		content: '#';
	}

	.prose :global(h2) {
		margin-top: 1.8em;
	}

	/* Sidenotes made from footnotes by src/plugins/sidenotes.mjs. Narrow screens
	   show each note under its line; wide ones float it into the right margin. */
	.prose :global(.sidenote-ref),
	.prose :global(.sidenote-number) {
		font-family: var(--font-mono, monospace);
		font-weight: 600;
		color: var(--color-accent);
	}

	.prose :global(.sidenote-ref) {
		font-size: 0.7em;
		margin-left: 0.1em;
	}

	.prose :global(.sidenote) {
		display: block;
		margin: 0.5em 0 0.8em;
		padding-left: 0.9em;
		border-left: var(--border-width-thick) solid var(--color-border);
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
	}

	/* Footnotes too long for the margin (lists, code) stay at the end. */
	.prose :global(.footnotes) {
		margin-top: 2.5em;
		padding-top: 1em;
		border-top: var(--border-width) solid var(--color-border);
		font-size: 0.88rem;
		color: var(--color-ink-soft);
	}

	@media (min-width: 72rem) {
		.prose :global(.sidenote) {
			float: right;
			clear: right;
			width: 13.5rem;
			/* Negative margin wider than the note hangs it fully outside the column. */
			margin: 0.3em -16rem 1em 0;
			padding-left: 0;
			border-left: 0;
		}

		/* Inline SVG charts are usually drawn wider than the text column, so at
		   column width their labels shrink below a readable size. Wide screens
		   let them spread into the empty margins on both sides instead. */
		.prose > :global(svg) {
			display: block;
			clear: right;
			width: calc(100% + 16rem);
			/* Charts set max-width: 100% inline so they fit narrow screens. */
			max-width: none !important;
			height: auto;
			margin-inline: -8rem;
		}
	}
</style>
