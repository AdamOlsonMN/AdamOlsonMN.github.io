---
import ArchiveBanner from '../components/ArchiveBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import VintageNote from '../components/VintageNote.astro';
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	tags?: string[];
	variant: 'blog' | 'archive';
	category?: 'commentary' | 'academic';
	context?: string;
}

const { title, description, pubDate, tags, variant, category, context } = Astro.props;
---

<Base title={title} description={description}>
	<article>
		{variant === 'archive' && category && (
			<ArchiveBanner pubDate={pubDate} category={category} context={context} />
		)}
		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				{tags && tags.length > 0 && (
					<span class="tags">
						{tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</span>
				)}
			</p>
		</header>
		{variant === 'blog' && <VintageNote pubDate={pubDate} />}
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	.post-header {
		margin-bottom: 1.5em;
	}

	.meta {
		color: var(--color-ink-soft);
		font-size: 0.92rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6em;
		margin-top: 0.3em;
	}

	.tags {
		display: flex;
		gap: 0.4em;
		flex-wrap: wrap;
	}

	.tag {
		background: var(--color-bg-elevated);
		border-radius: 999px;
		padding: 0.15em 0.7em;
		font-size: 0.82rem;
	}

	.prose :global(h2) {
		margin-top: 1.8em;
	}
</style>
