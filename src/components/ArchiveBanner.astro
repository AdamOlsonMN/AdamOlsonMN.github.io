---
import FormattedDate from './FormattedDate.astro';

interface Props {
	pubDate: Date;
	category: 'commentary' | 'academic';
	context?: string;
}

const { pubDate, category, context } = Astro.props;
const categoryLabel = category === 'academic' ? 'Academic life' : 'Political commentary';
---

<div class="archive-banner">
	<div class="stamp">
		<span class="stamp-date"><FormattedDate date={pubDate} /></span>
		<span class="sep" aria-hidden="true">·</span>
		<span class="stamp-category">{categoryLabel}</span>
	</div>
	<p>
		This post is kept in the <a href="/archive">archive</a> as written — a snapshot of an earlier
		version of me.
		{context}
	</p>
</div>

<style>
	.archive-banner {
		margin-bottom: 2em;
		padding: 1em 1.2em;
		background: var(--color-bg-elevated);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius);
	}

	.stamp {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-family: var(--font-mono, monospace);
		margin-bottom: 0.7em;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.sep {
		color: var(--color-border);
	}

	.archive-banner p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-ink-soft);
	}
</style>
