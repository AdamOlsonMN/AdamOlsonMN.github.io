---
import FormattedDate from './FormattedDate.astro';

interface Props {
	pubDate: Date;
	category: 'commentary' | 'academic';
	context?: string;
}

const { pubDate, category, context } = Astro.props;
const categoryLabel = category === 'academic' ? 'Academic life' : 'Political commentary';
---

<div class="archive-banner">
	<div class="stamp">
		<span class="stamp-date"><FormattedDate date={pubDate} /></span>
		<span class="stamp-category">{categoryLabel}</span>
	</div>
	<p>
		This post is kept in the <a href="/archive">archive</a> as written — a snapshot of an earlier
		version of me.
		{context}
	</p>
</div>

<style>
	.archive-banner {
		margin-bottom: 2em;
		padding: 1.1em 1.2em;
		background: var(--color-bg-elevated);
		border: var(--border-width-thick) solid var(--color-border);
	}

	.stamp {
		display: inline-flex;
		align-items: center;
		gap: 0;
		font-family: var(--font-heading, Arial, sans-serif);
		font-weight: 700;
		margin-bottom: 0.7em;
		font-size: 0.82rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.stamp-date,
	.stamp-category {
		background: var(--color-accent);
		color: var(--color-accent-ink);
		padding: 0.3em 0.7em;
	}

	.stamp-category {
		background: var(--color-ink);
		color: var(--color-bg);
	}

	.archive-banner p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-ink-soft);
	}
</style>
