---
import FormattedDate from './FormattedDate.astro';

interface Post {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
}

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={post.href}>
					<span class="date">
						<FormattedDate date={post.pubDate} />
					</span>
					<span class="title">{post.title}</span>
					<span class="description">{post.description}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		border-bottom: var(--border-width) solid var(--color-border);
	}

	li:first-child {
		border-top: var(--border-width) solid var(--color-border);
	}

	a {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 1.2em;
		row-gap: 0.2em;
		padding: 0.9em 0;
		text-decoration: none;
	}

	.date {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		color: var(--color-accent);
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
		width: 6.2em;
	}

	.title {
		font-weight: 600;
		color: var(--color-ink);
		flex: 1 1 auto;
	}

	a:hover .title {
		color: var(--color-accent);
	}

	.description {
		flex-basis: 100%;
		margin-left: 6.2em;
		color: var(--color-ink-soft);
		font-size: 0.88rem;
		font-weight: 400;
	}

	@media (max-width: 480px) {
		.description {
			margin-left: 0;
		}
	}
</style>
