---
import { SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="links">
		{
			SOCIAL_LINKS.map((link) => (
				<a href={link.href} rel={link.href.startsWith('http') ? 'me' : undefined}>
					{link.label}
				</a>
			))
		}
	</div>
	<p>&copy; {year} Adam Olson. Built with Astro, hosted on GitHub Pages.</p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--color-border);
		padding: 2em 1.25em 3em;
		text-align: center;
		color: var(--color-ink-soft);
		font-size: 0.92rem;
	}

	.links {
		display: flex;
		justify-content: center;
		gap: 1.3em;
		margin-bottom: 0.8em;
	}

	.links a {
		text-decoration: none;
		color: var(--color-ink-soft);
	}

	.links a:hover {
		color: var(--color-accent);
	}

	footer p {
		margin: 0;
	}
</style>
