---
const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} Adam Olson. Built with Astro, hosted on GitHub Pages.</p>
</footer>

<style>
	footer {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2em 1.5em 3em;
	}

	footer p {
		margin: 0;
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		color: var(--color-ink-soft);
	}
</style>
